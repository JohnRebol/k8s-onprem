<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Setup answer file -- this build's equivalent of ../packer/http/user-data.
  Same job (answer every installer prompt so the install runs unattended),
  completely different mechanism: Windows Setup finds this by scanning every
  attached volume for a file literally named autounattend.xml, rather than
  being told where to fetch it via a boot_command URL like Ubuntu's autoinstall.

  templatefile() substitutes the placeholders below, so winrm_password never
  gets committed here -- same reasoning as ../packer/http/user-data's
  ssh_password_hash. Unlike that file, this one *does* end up cached in
  cleartext-recoverable form at C:\Windows\Panther\unattend.xml on the
  installed system, because Windows Setup keeps a copy of the answer file it
  used. scripts/provision-apps.ps1 deletes that copy before the image is
  templated -- if you ever change what this file does, check that step still
  covers whatever ends up in Panther\.

  Setup applies this in ordered "passes". The three used here:
    windowsPE   runs inside the installer environment, before Windows exists
                on disk yet -- partitions the disk, picks the edition, and
                tells Setup where to find the virtio-scsi driver so it can
                even see the disk to partition.
    specialize  first real boot of the installed OS, still unattended --
                sets the computer name and turns on WinRM.
    oobeSystem  the final "out of box experience" pass a human normally
                clicks through -- skipped here by answering every question in
                advance (EULA, region, account creation, ...).
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend">

  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE"
                processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35"
                language="neutral" versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Setup"
                processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35"
                language="neutral" versionScope="nonSxS">

      <!--
        Setup can't see the virtio-scsi disk at all without this driver --
        Windows has no built-in one. Listing several drive letters because the
        exact one assigned to the VirtIO ISO (attached as ide1 in
        windows11.pkr.hcl) isn't guaranteed; if Setup still reports "no drives
        found", check Setup's log (accessible via Shift+F10 for a command
        prompt, mid-install) for which letter the second CD-ROM actually got,
        and add it here. "w11" is the driver subfolder in current virtio-win
        ISO releases -- if that folder doesn't exist in the version you
        downloaded, check the ISO's root for the closest match (e.g. "2k22").
      -->
      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Type>EFI</Type>
              <Size>260</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Type>MSR</Type>
              <Size>16</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>3</Order>
              <Type>Primary</Type>
              <Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Format>FAT32</Format>
              <Label>System</Label>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>2</PartitionID>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>3</Order>
              <PartitionID>3</PartitionID>
              <Format>NTFS</Format>
              <Label>Windows</Label>
              <Letter>C</Letter>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
      </DiskConfiguration>

      <ImageInstall>
        <OSImage>
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>3</PartitionID>
          </InstallTo>
        </OSImage>
      </ImageInstall>

      <UserData>
        <AcceptEula>true</AcceptEula>
        <ProductKey>
          <Key>${windows_product_key}</Key>
        </ProductKey>
      </UserData>
    </component>

    <!--
      This has to be its own component, not nested inside Microsoft-Windows-Setup
      above -- that was the actual bug behind an earlier crash (splash screen
      going blank and the VM rebooting partway through Setup, confirmed via a
      QEMU screendump, and confirmed fixed by comparing against a bare-bones
      VM with no answer file at all, which booted into Setup fine). Nested in
      the wrong place, this driver path was silently never applied, so Setup
      couldn't see the virtio-scsi disk it was told to partition below and
      crashed trying.
    -->
    <component name="Microsoft-Windows-PnpCustomizationsWinPE"
                processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35"
                language="neutral" versionScope="nonSxS">
      <DriverPaths>
        <PathAndCredentials wcm:action="add" wcm:keyValue="1">
          <Path>C:\vioscsi\w11\amd64</Path>
        </PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="2">
          <Path>D:\vioscsi\w11\amd64</Path>
        </PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="3">
          <Path>E:\vioscsi\w11\amd64</Path>
        </PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="4">
          <Path>F:\vioscsi\w11\amd64</Path>
        </PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="5">
          <Path>G:\vioscsi\w11\amd64</Path>
        </PathAndCredentials>
        <PathAndCredentials wcm:action="add" wcm:keyValue="6">
          <Path>H:\vioscsi\w11\amd64</Path>
        </PathAndCredentials>
      </DriverPaths>
    </component>
  </settings>

  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup"
                processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35"
                language="neutral" versionScope="nonSxS">
      <ComputerName>${computer_name}</ComputerName>
      <TimeZone>${timezone}</TimeZone>
    </component>

    <!--
      Turns on WinRM so Packer has something to connect to. This has to
      happen here, not in scripts/provision-apps.ps1, precisely because
      Packer can't run that script until WinRM is already listening --
      enable-winrm.ps1 is what breaks the chicken-and-egg problem. Same
      unknown-drive-letter caveat as the driver paths above: this loops over
      candidate letters at runtime instead of hardcoding one.
    -->
    <component name="Microsoft-Windows-Deployment"
                processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35"
                language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>Enable WinRM</Description>
          <Path>cmd /c for %d in (D E F G H) do if exist %d:\enable-winrm.ps1 powershell -NoProfile -ExecutionPolicy Bypass -File %d:\enable-winrm.ps1</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-Shell-Setup"
                processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35"
                language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <NetworkLocation>Work</NetworkLocation>
        <ProtectYourPC>3</ProtectYourPC>
        <SkipMachineOOBE>true</SkipMachineOOBE>
        <SkipUserOOBE>true</SkipUserOOBE>
      </OOBE>

      <!--
        Sets the password for, and enables, the built-in Administrator
        account -- it's disabled by default on a clean install. winrm_username
        defaults to "Administrator" in windows11.pkr.hcl specifically so this
        section is what provisions the account WinRM connects as; if you
        change winrm_username to something else, this needs a <LocalAccounts>
        block instead.
      -->
      <UserAccounts>
        <AdministratorPassword>
          <Value>${winrm_password}</Value>
          <PlainText>true</PlainText>
        </AdministratorPassword>
      </UserAccounts>

      <AutoLogon>
        <Enabled>true</Enabled>
        <Username>${winrm_username}</Username>
        <Password>
          <Value>${winrm_password}</Value>
          <PlainText>true</PlainText>
        </Password>
        <LogonCount>1</LogonCount>
      </AutoLogon>
    </component>
  </settings>

</unattend>
