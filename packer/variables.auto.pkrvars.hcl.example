# proxmox_url, proxmox_api_token_id, proxmox_api_token_secret, ssh_public_key,
# ssh_password_hash, and ssh_private_key_file are supplied via .env (PKR_VAR_*)
# — see repo-root README.md.
proxmox_node         = "pve2"
datastore_id         = "lvl-local"
network_bridge       = "vmbr0"

ubuntu_version       = "26.04"
ubuntu_iso_url       = "https://releases.ubuntu.com/26.04/ubuntu-26.04-live-server-amd64.iso"
ubuntu_iso_checksum  = "file:https://releases.ubuntu.com/26.04/SHA256SUMS"
ssh_username         = "<username>"

k8s_template_vm_id       = 9000
kubernetes_repo_version  = "v1.35"
hold_kubernetes_packages = true
