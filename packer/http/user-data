#cloud-config

autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us

  network:
    version: 2
    ethernets:
      any-ens:
        match:
          name: en*
        dhcp4: true

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - "${ssh_public_key}"



  identity:
    hostname: k8s-golden
    username: ${ssh_username}
    password: ${ssh_password_hash}
  storage:
    layout:
      name: direct

  packages:
  - qemu-guest-agent
  - openssh-server

  late-commands:
    - echo '${ssh_username} ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/90-${ssh_username}
    - chmod 440 /target/etc/sudoers.d/90-${ssh_username}
