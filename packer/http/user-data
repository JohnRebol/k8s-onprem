#cloud-config

autoinstall:
  version: 1

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - "${ssh_public_key}"



  identity:
    hostname: k8s-golden
    username: ${ssh_username}
    password: ${ssh_password_hash}
  storage:
    layout:
      name: direct

  packages:
  - qemu-guest-agent
  - openssh-server

keyboard:
  layout: us

users:
  - name: ${ssh_username}
    gecos: Kubernetes image builder
    groups: [adm, sudo]
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}

ssh_pwauth: false
package_update: true
package_upgrade: false
