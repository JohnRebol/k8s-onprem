{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read(**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform plan:*)",
      "Bash(tflint:*)",
      "Bash(packer validate:*)",
      "Bash(packer fmt:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl explain:*)",
      "Bash(kubectl diff:*)",
      "Bash(helm template:*)",
      "Bash(helm lint:*)",
      "Bash(ansible-lint:*)",
      "Bash(yamllint:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker images:*)",
      "Bash(trivy image:*)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:developer.hashicorp.com)",
      "WebFetch(domain:kubernetes.io)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.ansible.com)",
      "WebFetch(domain:argo-cd.readthedocs.io)",
      "WebFetch(domain:goharbor.io)"
    ],
    "deny": [
      "Edit(**/*.tf)",
      "Edit(**/*.tfvars)",
      "Edit(**/*.pkr.hcl)",
      "Edit(**/*.pkrvars.hcl)",
      "Edit(**/*.yaml)",
      "Edit(**/*.yml)",
      "Edit(**/Dockerfile*)",
      "Edit(**/docker-compose*)",
      "Edit(**/.github/workflows/**)",
      "Edit(**/*.sh)",
      "Read(**/.env*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/kubeconfig*)",
      "Read(**/.kube/config)",
      "Read(**/*.auto.pkrvars.hcl)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(packer build:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl edit:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(ansible-playbook:*)",
      "Bash(argocd app sync:*)",
      "Bash(docker compose up:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)"
    ],
    "ask": [
      "Edit(notes/**)",
      "Edit(docs/**)",
      "Edit(incidents/**)"
    ],
    "defaultMode": "plan"
  },
  "outputStyle": "Learning",
  "theme": "dark"
}
